# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Google Sheets (contact-form / aws-enquiry / linkedin-lead lead capture)
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
SPREADSHEET_ID=

# Resend (transactional email)
RESEND_API_KEY=
ADMIN_EMAIL=

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=
SANITY_PREVIEW_SECRET=

# Google API (chatbot embeddings)
GOOGLE_API_KEY=

# Hugging Face (chatbot embeddings)
HUGGINGFACE_API_KEY=

# Chatbot Google Sheet (chat log capture)
CHATBOT_GOOGLE_SHEET_ID=
CHATBOT_GOOGLE_CLIENT_EMAIL=
CHATBOT_GOOGLE_PRIVATE_KEY=

# WhatsApp support link
WHATSAPP_SUPPORT_NUMBER=

# OpenAI Ads Conversions API (course lead form - lead_created event,
# reported server-side alongside the browser oaiq Pixel; Pixel ID itself
# is not a secret and is hardcoded in src/components/common/OpenAiPixel.tsx)
OPENAI_CONVERSIONS_API_KEY=

# Site URL (used for sitemap, JSON-LD, and OpenGraph metadata; defaults to
# https://eduwise.solutions if unset)
NEXT_PUBLIC_SITE_URL=

# --- Lead-form security layer (src/lib/security/) - see docs/SECURITY.md ---
# Every check below fails OPEN (skips itself, logs a warning) when its
# variable is unset, so leaving any of these blank does not block real
# leads - it just means that specific layer of defense isn't active yet.

# Signs the anti-spam form token (src/lib/security/form-token.ts). Any
# long random string. Generate with: openssl rand -base64 32
ANTI_SPAM_SECRET=

# Cloudflare Turnstile (src/lib/security/turnstile.ts). Get real keys from
# the Cloudflare dashboard. Until set, forms use Cloudflare's public TEST
# sitekey (1x00000000000000000000AA) - the widget renders and works, but
# blocks nothing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (src/lib/security/rate-limit.ts) - distributed rate
# limiting, required because this app runs serverless/multi-instance on
# Vercel where an in-memory counter would not be shared across instances.
# Provision via the Vercel Marketplace (Upstash integration) or
# upstash.com directly; both env var names below are what Upstash's own
# SDK (Redis.fromEnv()) expects.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
